{
  "name": "@huui/cdx-switcher",
  "version": "1.8.7",
  "type": "module",
  "description": "Unofficial community CLI for switching locally stored credentials across compatible developer tools",
  "bin": {
    "cdx": "cdx.ts"
  },
  "scripts": {
    "build": "tsdown && bun run scripts/build-dist-pkg.ts",
    "prerelease": "bun run build",
    "check-publish-metadata": "bun run scripts/check-publish-metadata.ts",
    "release": "bun run check-publish-metadata && npm publish --access public ./dist",
    "wait-npm-latest": "bun run scripts/wait-for-npm-latest.ts"
  },
  "keywords": [
    "openai",
    "opencode",
    "codex",
    "account-switcher",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleHuui/codex-switcher.git"
  },
  "license": "MIT",
  "author": "huui",
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.5.0",
    "tsdown": "^0.21.2"
  },
  "dependencies": {
    "@bjesuiter/cross-keychain": "1.1.0-jb.0",
    "@bomb.sh/tab": "^0.0.14",
    "@clack/prompts": "^1.1.0",
    "age-encryption": "^0.3.0",
    "commander": "^14.0.3"
  }
}
